[gd_resource type="Resource" script_class="NarratorCue" format=3]

[ext_resource type="Script" path="res://core/narrator/narrator_cue.gd" id="1_cue"]

[resource]
script = ExtResource("1_cue")
subtitle = "Good morning sunshine! You've decided to work overtime today for some reason, at a comic publisher of all places. You'd have loved to be a stand-up comic, but that doesn't pay the bills so here you are. Well, dreary work builds character or something. Get to it!"
