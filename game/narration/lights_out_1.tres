[gd_resource type="Resource" script_class="NarratorCue" format=3]

[ext_resource type="Script" path="res://core/narrator/narrator_cue.gd" id="1_cue"]

[resource]
script = ExtResource("1_cue")
subtitle = "YOU FELL FOR THAT?? You can't work without the lights! Oh well, let's find some way to fix this, shall we? Usually, where there's lights there's a switch somewhere. Oh we also have a server room, I am sure it exists for a reason."
once = true
