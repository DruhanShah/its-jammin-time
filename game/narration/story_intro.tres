[gd_resource type="Resource" script_class="NarratorCue" format=3]

[ext_resource type="Script" path="res://core/narrator/narrator_cue.gd" id="1_cue"]

[resource]
script = ExtResource("1_cue")
subtitle = "You've finally come to. Don't worry, you didn't miss anything. There's just warm, comforting darkness. You find this exciting somehow, like watching paint dry or watching grass grow. Riveting stuff! Alas, Life has more to it than this. You must wake"
once = true
