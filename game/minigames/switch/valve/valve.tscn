[node name="BulbLight" type="OmniLight3D" parent="Switchboard"]
transform = Transform3D(1, 0, 0, 0, 1, 0, 0, 0, 1, 0, 0.22, 0.18)
light_color = Color(1, 0.85, 0.45, 1)
light_energy = 0.0
omni_range = 0.7

[node name="TwistInput" type="Node" parent="."]
script = ExtResource("3_twist")

[node name="TurnLoop" type="AudioStreamPlayer" parent="."]
stream = ExtResource("11_turn")
volume_db = -60.0
autoplay = true
bus = &"SFX"

[node name="FlowLoop" type="AudioStreamPlayer" parent="."]
stream = ExtResource("13_flow")
volume_db = -30.0
autoplay = true
bus = &"SFX"

[node name="Surge" type="AudioStreamPlayer" parent="."]
stream = ExtResource("14_surge")
bus = &"SFX"

[node name="Hud" type="CanvasLayer" parent="."]

[node name="Burst" type="Control" parent="Hud"]
layout_mode = 3
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
grow_horizontal = 2
grow_vertical = 2
mouse_filter = 2

[node name="Hint" parent="Hud" node_paths=PackedStringArray("twist") instance=ExtResource("4_hint")]
custom_minimum_size = Vector2(280, 280)
anchors_preset = 2
anchor_top = 1.0
anchor_bottom = 1.0
offset_left = 20.0
offset_top = -400.0
offset_right = 300.0
offset_bottom = -120.0
grow_vertical = 0
twist = NodePath("../../TwistInput")
feedback = false
