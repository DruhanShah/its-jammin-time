; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

[application]

config/name="Infinium Game Jam"
run/main_scene="res://world/office/office.tscn"
config/features=PackedStringArray("4.7", "GL Compatibility")
config/icon="res://icon.svg"

[asset_placer]

general/asset_library_path="res://assets/asset_placer_library.json"

[autoload]

_mcp_game_helper="*res://addons/godot_ai/runtime/game_helper.gd"
Audio="*res://core/audio/audio.tscn"
Narrator="*res://core/narrator/narrator.tscn"
GameState="*res://core/game_state.gd"
Transition="*res://core/transition/transition.tscn"
Story="*res://core/story.gd"

[display]

window/stretch/mode="canvas_items"
window/stretch/aspect="expand"

[editor_plugins]

enabled=PackedStringArray("res://addons/asset_placer/plugin.cfg", "res://addons/godot_ai/plugin.cfg", "res://addons/snappy/plugin.cfg")

[gui]

theme/custom="res://core/ui/theme.tres"

